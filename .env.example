# BookLeaf Author Support Portal - Environment Configuration

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=bookleaf_super_secret_jwt_key_2026

# SQLite Database File Path
DB_PATH=./data/bookleaf.db

# AI Provider Selection: 'openai' | 'anthropic' | 'gemini' | 'heuristic_engine'
# If left blank, automatically detects available keys or gracefully falls back to the deterministic Knowledge Base engine.
AI_PROVIDER=heuristic_engine

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Google Gemini Configuration (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
